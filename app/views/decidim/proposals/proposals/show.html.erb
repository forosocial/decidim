<%# app/views/decidim/proposals/proposals/show.html.erb %>
<%# Depende de app/services/conflicto_mapper.rb %>
<%# Necesita config/initializers/preseleccion_taxonomias_propuestas.rb %>

<% add_decidim_meta_tags(
  description: present(@proposal).body,
  title: present(@proposal).title,
  url: proposal_url(@proposal.id),
  resource: @proposal) %>

<%
  edit_link(
    resource_locator(@proposal).edit,
    :edit,
    :proposal,
    proposal: @proposal
  )
%>

<%
extra_admin_link(
  resource_locator(@proposal).show(anchor: "proposal-answer"),
  :create,
  :proposal_answer,
  { proposal: @proposal },
  { name: t("answer", scope: "decidim.proposals.proposals.show"), icon: "question-answer-line" }
)
%>

<% append_stylesheet_pack_tag "decidim_proposals", media: "all" %>
<% append_javascript_pack_tag "decidim_proposals" %>

<% content_for :item_header do %>
  <% if show_voting_rules? %>
    <div class="layout-item-complementary">
      <%= render partial: "update_proposal_voting_rules" %>
    </div>
  <% end %>
<% end %>

<% content_for :aside do %>
  <%= render partial: "proposal_aside" %>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_item", locals: { back_path: component_settings.participatory_texts_enabled? ? main_component_path(current_component) : proposals_path } do %>

  <section class="layout-main__section layout-main__heading">
    <% if show_voting_rules? && remaining_minimum_votes_count_for_user.positive? && current_component.participatory_space.can_participate?(current_user) %>
      <%= render partial: "exit_modal" %>
    <% end %>

    <%= cell("decidim/announcement", proposal_reason_callout_announcement, callout_styles: @proposal.proposal_state&.css_style) if @proposal.answered? && @proposal.published_state? %>

    <%= emendation_announcement_for @proposal %>

    

    <% if @proposal.emendation? %>
      <h1 class="h2 decorator"><%= t("changes_at_title", scope: "decidim.proposals.proposals.show", title: present(@proposal.amendable).title(html_escape: true)) %></h1>
    <% else %>
      <h1 class="h2 decorator"><%= present(@proposal).title(html_escape: true) %></h1>
    <% end %>
    
    

    <% unless component_settings.participatory_texts_enabled? %>
      <% unless ["section","subsection"].include?(@proposal.participatory_text_level) %>
        <div class="layout-author has_status">
          <%= cell("decidim/proposals/proposal_metadata", @proposal).state_item&.dig(:text) %>
        </div>
      <% end %>
      <div class="layout-author <%= "has_status" unless %w(section subsection).include?(@proposal.participatory_text_level) %>">
        <div class="relative flex items-center justify-center w-full">
          <div class="w-10/12 flex items-center gap-4">
            <%= cell "decidim/coauthorships", @proposal, context_actions: [:date] %>
          </div>
          <%= render "decidim/shared/resource_actions", resource: @proposal do %>
            <%= render "decidim/proposals/proposals/proposal_actions" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  
  <section class="layout-main__section">
    <% if @proposal.emendation? %>
      <%= cell(
            "decidim/diff",
            proposal_presenter.versions.last,
            path: proc { |extra_params| url_for(action: :show, id: params[:id], **extra_params) }
          ) %>
    <% elsif not ["section","subsection"].include? @proposal.participatory_text_level %>
      <div class="editor-content">
        <%= render_proposal_body(@proposal) %>
      </div>
    <% end %>
  </section>

  <% if proposal_has_costs? && current_settings.answers_with_costs? %>
    <section class="layout-main__section">
      <%= cell("decidim/proposals/cost_report", @proposal) %>
    </section>
  <% end %>

  <% if component_settings.geocoding_enabled? && @proposal.geocoded? %>
    <div class="static-map__container py-6">
      <%= render partial: "decidim/shared/static_map", locals: { icon_name: "proposals", geolocalizable: @proposal } %>
    </div>
  <% end %>

  <%# ------------------------------ %>
  <%# Nuevos enlaces insertados aquí %>
  <%# ------------------------------ %>
  <br>
  <% componente_actual = @proposal.decidim_component_id %>
  <% id_componente_pactos = ConflictoMapper.id_componente_pactos %>
  <% id_componente_conflictos = ConflictoMapper.id_componente_conflictos %>
  <% id_componente_propuestas = ConflictoMapper.id_componente_propuestas %>

  <% if [id_componente_conflictos, id_componente_propuestas].include?(componente_actual) %>
    <% comp_conflictos = Decidim::Component.find_by(id: id_componente_conflictos) %>
    <% comp_propuestas = Decidim::Component.find_by(id: id_componente_propuestas) %>
    <% pacto_item = ConflictoMapper.pacto_item_de(@proposal) %>
    <% tax_pacto_id = pacto_item&.id %>
    <% pacto_root_id = pacto_item ? ConflictoMapper.raiz(pacto_item).id : nil %>

    <% pacto = tax_pacto_id && Decidim::Proposals::Proposal
          .where(decidim_component_id: id_componente_pactos, decidim_proposals_proposal_state_id: nil)
          .joins(:taxonomies)
          .where("decidim_taxonomies.id = ?", tax_pacto_id)
          .first %>

    <%# ---- Página de PROPUESTA: lista de conflictos (multi) ---- %>
    <% if componente_actual == id_componente_propuestas && comp_conflictos %>
        
      <% ConflictoMapper.grupos_de(@proposal).each do |grupo_item| %>
      <%# Caso de existir propuestas relacionadas con esta propuesta %>
        <%= link_to t("decidim.proposals.proposals.show.ver_relacionadas", grupo: grupo_item.name["es"]),
            Decidim::EngineRouter.main_proxy(current_component).proposals_path(
              filter: { with_any_taxonomies: { ConflictoMapper.raiz_agrupaciones.id => [grupo_item.id] } }) %>
      <% end %>
    
      <% aborda_conflictos = ConflictoMapper.conflictos_de_propuesta(@proposal, comp_conflictos) %>
      <% if aborda_conflictos.any? %>
      
        <div>
          <%= aborda_conflictos.one? ? t("aborda_conflicto_html", scope: "decidim.conflicto_propuesta.overrides") : t("aborda_conflictos_html", scope: "decidim.conflicto_propuesta.overrides") %>
        </div>

        <div class="flash flex-col warning">
          <% aborda_conflictos.each do |conf| %>
            <h2 class="h4 flex items-center gap 2 mb-4">
              <% if conf[:proposal] %>
                <%= link_to conf[:texto], resource_locator(conf[:proposal]).path, target: "_blank", rel: "noopener noreferrer" %>
              <% else %>
                <%= conf[:texto] %>
              <% end %>
            </h2>
          <% end %>
        </div>
      <% end %>
    <% end %>

    
    <%# ---- Página de CONFLICTO: enlace a sus propuestas ---- %>
    <% item_conf = ConflictoMapper.conflicto_item_de(@proposal) %>
    <% es_conflicto = item_conf.present? && item_conf.parent_id == ConflictoMapper.raiz(item_conf).id %>
    <% if componente_actual == id_componente_conflictos && es_conflicto && comp_propuestas %>
      <% n = ConflictoMapper.propuestas_para_conflicto(@proposal, comp_propuestas) %>
      <div class="flash flex-col warning">
        <% if n.positive? %>
          <% conflicto_root_id = ConflictoMapper.raiz(item_conf).id %>
          <% query = { filter: { with_any_state: ["state_not_published"],
                                with_any_taxonomies: { pacto_root_id => [tax_pacto_id],
                                                        conflicto_root_id => item_conf.children.ids } } }.to_query %>
          <%= link_to t("ver_todas_propuestas_html", scope: "decidim.conflicto_propuesta.overrides") ,
                "#{main_component_path(comp_propuestas)}?#{query}", target: "_blank", rel: "noopener noreferrer" %>
                
        <% else %>
          <%= t("sin_propuestas_html", scope: "decidim.conflicto_propuesta.overrides") %>
        <% end %>
      </div>
      
      <%# -------------------------- %>
      <%# Botón: admin → form admin, usuario → form público, anónimo → nada %>
      <%# -------------------------- %>
      <% pre_ids = ConflictoMapper.preseleccion_para(@proposal) %>
      <% comp_propuestas = ConflictoMapper.componente_propuestas(current_component) %>
      <% puede_crear = current_user && allowed_to?(:create, :proposal,
                                        current_component: comp_propuestas,
                                        current_settings: comp_propuestas.current_settings,
                                        current_participatory_space: comp_propuestas.participatory_space) %>
      <% if puede_crear && pre_ids && comp_propuestas %>
        <div class="layout-main__section">
          <% if current_user.admin? %>
            <%= link_to t("crear_propuesta_conflicto", scope: "decidim.conflicto_propuesta.overrides"),
                  Decidim::EngineRouter.admin_proxy(comp_propuestas).new_proposal_path(pre_taxonomies: pre_ids),
                  class: "button button__sm button__secondary", target: "_blank", rel: "noopener" %>
          <% else %>
            <%= link_to t("crear_propuesta_conflicto", scope: "decidim.conflicto_propuesta.overrides"),
                  Decidim::EngineRouter.main_proxy(comp_propuestas).new_proposal_path,
                  class: "button button__sm button__secondary", target: "_blank", rel: "noopener" %>
          <% end %>
        </div>
      <% end %>
      <%# -------------------------- %>
      <%# Fin de las modificación  %>
      <%# -------------------------- %>
    <% end %>

    <div class="flash flex-col warning">
      <%# ---- En ambas: ver todos los conflictos del pacto ---- %>

      <% if pacto %>
        <h2 class="h4 flex items-center gap 2 mb-4">
          <%= link_to present(pacto).title, resource_locator(pacto).path, target: "_blank", rel: "noopener noreferrer" %>
        </h2>
      <% end %>

      <% if comp_conflictos && tax_pacto_id %>
        <% query = { filter: { with_any_taxonomies: { pacto_root_id => [tax_pacto_id] } } }.to_query %>
        <%= link_to t("ver_todos_conflictos_html", scope: "decidim.conflicto_propuesta.overrides"),
              "#{main_component_path(comp_conflictos)}?#{query}", target: "_blank", rel: "noopener noreferrer" %>
      <% end %>
    </div>
  <% end %>

  <%# -------------------------- %>
  <%# Fin de las modificación  %>
  <%# -------------------------- %>

  <%# ----------------------------------------- %>
  <%#- Enlace a los Conflictos de un Pacto      %>
  <%# ----------------------------------------- %>
  <% if id_componente_pactos == componente_actual %>
    <div class="flash flex-col warning" >
      <% tax_pacto_id = ConflictoMapper.preseleccion_pacto(@proposal) %>
      <% ruta = "/processes/#{Decidim::ParticipatoryProcess.first&.slug}/f/#{id_componente_conflictos}/proposals?" %>
      <% ruta = ruta + "filter[with_any_state][]=&filter[with_any_state][]=state_not_published&filter[with_any_state]" %>
      <% ruta = ruta + "[]=&filter[with_any_taxonomies[16]][]=&filter[with_any_taxonomies[1]][]=&filter" %>
      <% ruta = ruta + "[with_any_taxonomies[1]][]=#{tax_pacto_id}&filter[with_any_origin][]=&filter[type]=&filter[type]=all&order=random" %>

      <%= link_to t("ver_todos_conflictos_html", scope: "decidim.conflicto_propuesta.overrides"),
            ruta, target: "_blank", rel: "noopener noreferrer" %>
    </div>
  <% end %>
  <%# ----------------------------------------- %>

  <%= cell "decidim/tab_panels", tab_panel_items %>

  <section class="layout-main__section">
    <%= cell "decidim/amendable/amendments", @proposal %>
  </section>

  <%= cell "decidim/tags", @proposal %>

  <%= render partial: "actions" %>

  <% content_for :item_footer do %>
    <%= comments_for @proposal %>

     <ul class="metadata__container layout-main__section" data-metadata-footer>
       <%= content_tag :li, resource_reference(@proposal), class: "metadata__item" %>
       <%= content_tag :li, resource_version(proposal_presenter, versions_path: proposal_version_path(@proposal, proposal_presenter.versions.count)), class: "metadata__item" %>

      <% fingerprint_id = dom_id(@proposal, :fingerprint_dialog) %>
      <%= content_tag :li, class: "metadata__item" do %>
        <%= content_tag :button, t("decidim.fingerprint.check"), data: { dialog_open: fingerprint_id } %>
      <% end %>
    </ul>
    <%= decidim_modal id: fingerprint_id, class: "fingerprint-modal" do %>
      <div data-dialog-container>
        <%= icon "fingerprint-line" %>
        <h2 id="dialog-title-<%= fingerprint_id %>" tabindex="-1" data-dialog-title><%= t "decidim.fingerprint.title" %></h2>
        <div class="fingerprint-modal__container">
          <p id="dialog-desc-<%= fingerprint_id %>"><%= t "decidim.fingerprint.explanation" %></p>
          <div>
            <span class="fingerprint-modal__span"><%= t "decidim.fingerprint.value" %>:</span>
            <code class="fingerprint-modal__code"><%= decidim_html_escape @proposal.fingerprint.value %></code>
          </div>
          <div>
            <span class="fingerprint-modal__span"><%= t "decidim.fingerprint.source" %>:</span>
            <code class="fingerprint-modal__code"><%= @proposal.fingerprint.source %></code>
          </div>
          <p><%= t("decidim.fingerprint.replicate_help", online_calculator_link: link_to(t("decidim.fingerprint.online_calculator_name"), "http://www.md5calc.com/sha256", target: "_blank", rel: "noopener")).html_safe %></p>
        </div>
      </div>
    <% end %>
  <% end %>

<% end %>
