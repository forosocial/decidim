<%# app/views/decidim/participatory_processes/arbol/show.html.erb %>

<% add_decidim_meta_tags(title: t("decidim.participatory_processes.arbol.title", process: translated_attribute(current_participatory_space.title))) %>

<div class="layout-item">
  <% aid = "arbol-ayuda-#{current_participatory_space.id}" %>
  <h1 class="h3 decorator arbol-titulo" style="grid-column: 1 / -1;">
    <%= t("decidim.participatory_processes.arbol.title", process: translated_attribute(current_participatory_space.title)) %>
    <%= tag.label(for: aid, class: "button button__xs button__text-secondary arbol-ayuda-boton ") do %>
      <svg width="1em" height="1em" role="img" aria-hidden="true">
        <use href="/decidim-packs/media/images/remixicon.symbol-4fb70727220f022f5864.svg#ri-question-line">
        </use>
      </svg>
      <span data-accessibility-violation="true">
        <%= t("decidim.participatory_processes.arbol.ayuda_boton") %>
      </span>
      
    <% end %>
  </h1>

  <%# alternador global: despliega/encoge todos los bodies a la vez %>
  <% gid = "arbol-global-#{current_participatory_space.id}" %>
  <div class="arbol-global-row">
    <%= tag.input(type: "checkbox", id: gid, class: "arbol-global-state") %>
    <%= tag.label(for: gid, class: "arbol-global") do %>
      <span class="arbol-global-icon">▸</span>
      <%= t("decidim.participatory_processes.arbol.desplegar_todo") %>
    <% end %>
  </div>

  <%# ayuda: modal con la leyenda (checkbox hack, sin JS).
      El label-boton vive DENTRO del h1 (tras el titulo, sin salto de linea);
      el input y el modal quedan aqui como hermanos (CSS con ~). %>
  <%= tag.input(type: "checkbox", id: aid, class: "arbol-ayuda-state") %>
  <div class="arbol-modal" role="dialog" aria-modal="true">
    <div class="arbol-modal-caja">
      <%= tag.label("✕", for: aid, class: "arbol-modal-cerrar", title: t("decidim.participatory_processes.arbol.ayuda_cerrar")) %>
      <h1 class="h3 decorator" style="grid-column: 1 / -1;"><%= t("decidim.participatory_processes.arbol.ayuda_titulo") %></h1>
      <br>
      <p><%= simple_format(t("decidim.participatory_processes.arbol.ayuda_pacto_txt")) %></p>
      <br>
      <ul class="arbol-tree">
        <li>
          <div class="arbol-node arbol-node--grupo"><span class="arbol-marker"></span>
            <%= t("decidim.participatory_processes.arbol.ayuda_grupo") %></div>
          <ul>
            <li>
              <div class="arbol-node arbol-node--pacto"><span class="arbol-marker"></span>
                <%= t("decidim.participatory_processes.arbol.ayuda_pacto") %></div>
              <ul>
                <li>
                  <div class="arbol-node arbol-node--conflicto"><span class="arbol-marker"></span>
                    <%= t("decidim.participatory_processes.arbol.ayuda_conflicto") %></div>
                  <ul>
                    <li>
                      <div class="arbol-node arbol-node--propuesta"><span class="arbol-marker"></span>
                        <%= t("decidim.participatory_processes.arbol.ayuda_propuesta") %></div>
                    </li>
                  </ul>
                </li>
              </ul>
            </li>
          </ul>
        </li>
      </ul>
      
      <p><%= t("decidim.participatory_processes.arbol.ayuda_conflicto_txt") %></p>
      <br>
      <p>
        <span class="arbol-estado arbol-estado--consensuada"><%= t("decidim.participatory_processes.arbol.estados.consensuada") %></span>
        <span class="arbol-estado arbol-estado--evaluating"><%= t("decidim.participatory_processes.arbol.estados.evaluating") %></span>
      </p>
      <br>
      <p><%= t("decidim.participatory_processes.arbol.ayuda_toggle_txt") %></p>
      <br>
      
      <p><%= t("decidim.participatory_processes.arbol.ayuda_estados_txt", process: translated_attribute(current_participatory_space.title)) %></p>
      <br>
      <span class="arbol-global-modal"><%= t("decidim.participatory_processes.arbol.desplegar_todo") %></span>

    </div>
  </div>

  <%# modo "solo consensuada" por nivel: cuando el ESTADOS_* de ese nivel es
      exactamente [:sin_respuesta], ese nivel no pinta botones y el titulo
      lleva el enlace a la proposal consensuada %>
  <% solo_pactos = solo_consensuadas?(ArbolConfig::ESTADOS_PACTOS) %>
  <% solo_conflictos = solo_consensuadas?(ArbolConfig::ESTADOS_CONFLICTOS) %>
  <% solo_propuestas = solo_consensuadas?(ArbolConfig::ESTADOS_PROPUESTAS) %>

  <%# agrupacion por padre ("Pactos transversales" primero, "Pactos
      tematicos" despues): id de padre DESCENDENTE; pactos por id
      ascendente dentro de cada rama. Ramas padre: etiqueta sin enlace. %>
  <% ramas_por_padre = arbol.group_by { |pacto_item, _| pacto_item.parent }
                            .sort_by { |padre, _| -(padre&.id || 0) } %>

  <ul class="arbol-tree">
  <% ramas_por_padre.each do |padre, ramas| %>
    <li>
      <div class="arbol-node arbol-node--grupo">
        <span class="arbol-marker"></span>
        <span><%= (padre ? translated_attribute(padre.name) : "—") %></span>
      </div>
      <ul>
        <% ramas.sort_by { |pacto_item, _| pacto_item.id }.each do |pacto_item, rama| %>
          <li>
            <div class="arbol-node arbol-node--pacto">
          <span class="arbol-marker"></span>
          <% pp_filtradas = rama[:pacto_propuestas_filtradas].to_a %>
          <% if solo_pactos %>
            <%# sin botones "consensuada": el titulo del pacto lleva el enlace %>
            <% if pp_filtradas.any? %>
              <%= link_to router_pactos.proposal_path(pp_filtradas.first), target: "_blank", rel: "noopener" do %>
                <%= translated_attribute(pacto_item.name) %>
              <% end %>
            <% else %>
              <%= translated_attribute(pacto_item.name) %>
            <% end %>
          <% else %>
            <span><%= translated_attribute(pacto_item.name) %></span>
            <% ordenar_por_estado(pp_filtradas).each do |pp| %>
              <%= link_to router_pactos.proposal_path(pp), target: "_blank", rel: "noopener" do %>
                <%= etiqueta_estado(pp) %>
              <% end %>
            <% end %>
          <% end %>
            <span class="arbol-contador"><%= t("decidim.participatory_processes.arbol.n_conflictos", count: rama[:conflictos].map { |n| n[:conflicto_item].id }.uniq.size) %></span>
            <%= desplegable_body(pp_filtradas.find { |p| p.state.nil? } || pp_filtradas.first, sufijo: "p-#{pacto_item.id}") %>
        </div>

        <ul>
          <% if rama[:conflictos].empty? %>
            <li><span class="arbol-vacio"><%= t("decidim.participatory_processes.arbol.sin_conflictos") %></span></li>
          <% end %>
          <%# un nodo por item "Conflicto N": los records (propuesta original,
              enmiendas, duplicados) se agrupan en una sola linea, con un
              boton de estado por cada uno, enlazando a su proposal. Las
              hojas se unen y deduplican por id entre los records. %>
          <% rama[:conflictos].group_by { |n| n[:conflicto_item].id }.each do |_, nodos| %>
            <% principal = nodos.first %>
            <% records = nodos.map { |nd| nd[:conflicto] } %>
            <% hojas = nodos.flat_map { |nd| nd[:propuestas].to_a }.uniq(&:id) %>
            <li>
              <div class="arbol-node arbol-node--conflicto">
                <span class="arbol-marker"></span>
                <% if solo_conflictos %>
                  <%# sin botones: el titulo del conflicto lleva el enlace %>
                  <%= link_to translated_attribute(principal[:conflicto].title),
                              router_conflictos.proposal_path(principal[:conflicto]),
                              target: "_blank", rel: "noopener" %>
                <% else %>
                  <span><%= translated_attribute(principal[:conflicto].title) %></span>
                  <% ordenar_por_estado(records).each do |rec| %>
                    <%= link_to router_conflictos.proposal_path(rec), target: "_blank", rel: "noopener" do %>
                      <%= etiqueta_estado(rec) %>
                    <% end %>
                  <% end %>
                <% end %>
                <span class="arbol-contador"><%= t("decidim.participatory_processes.arbol.n_propuestas", count: hojas.size) %></span>
                <%# boton_nueva_propuesta_conflicto(principal[:conflicto]) %>
                <%= desplegable_body(records.find { |r| r.state.nil? } || records.first, sufijo: "c-#{principal[:conflicto].id}") %>
              </div>

              <ul>
                <% if hojas.empty? %>
                  <li><span class="arbol-vacio"><%= t("decidim.participatory_processes.arbol.sin_propuestas") %></span></li>
                <% end %>
                <%# hojas: una linea por titulo; si hay varios records con el
                    mismo titulo (enmiendas/duplicados), un boton por record %>
                <% ordenar_por_estado(hojas).group_by { |pr| translated_attribute(pr.title) }.each do |_, prs| %>
                  <li>
                    <div class="arbol-node arbol-node--propuesta">
                      <span class="arbol-marker"></span>
                      <% if solo_propuestas %>
                        <%# sin botones: el titulo de la propuesta lleva el enlace %>
                        <%= link_to translated_attribute(prs.first.title),
                                    router_propuestas.proposal_path(prs.first),
                                    target: "_blank", rel: "noopener" %>
                      <% else %>
                        <span><%= translated_attribute(prs.first.title) %></span>
                        <% prs.each do |pr| %>
                          <%= link_to router_propuestas.proposal_path(pr), target: "_blank", rel: "noopener" do %>
                            <%= etiqueta_estado(pr) %>
                          <% end %>
                        <% end %>
                      <% end %>
                      <%= desplegable_body(prs.find { |r| r.state.nil? } || prs.first, sufijo: "h-#{principal[:conflicto].id}-#{prs.first.id}") %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>
        </ul>
          </li>
        <% end %>
      </ul>
    </li>
  <% end %>
  </ul>
</div>
